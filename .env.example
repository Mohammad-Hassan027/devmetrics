# Copy to .env and fill values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: set redirect URL for OAuth if needed
# VITE_SUPABASE_REDIRECT_URL=http://localhost:5173
# Supabase project ID (used by the generation script). Get it from your Supabase dashboard.
# SUPABASE_PROJECT_ID=your-project-id
#
# Alternative: you can provide a database URL instead of a project id. In that case
# set `SUPABASE_DB_URL` (postgres connection string) and run the generator with
# `--db-url` manually:
# npx supabase gen types typescript --db-url "$SUPABASE_DB_URL" --schema public > src/types/supabase.ts

# npx skills add supabase/agent-skills